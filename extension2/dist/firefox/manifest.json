{
  "manifest_version": 3,
  "name": "wren speak",
  "version": "0.4",
  "description": "Send text to the wren TTS daemon",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "wren",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage",
    "alarms"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wren-speak@example.com"
    }
  }
}
