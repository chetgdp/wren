{
  "manifest_version": 3,
  "name": "wren speak",
  "version": "0.4",
  "description": "Send text to the wren TTS daemon",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage",
    "offscreen",
    "alarms"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"] }
  ],
  "action": {
    "default_title": "wren",
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html" }
}
